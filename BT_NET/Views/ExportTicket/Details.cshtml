@model BT_NET.Models.Entities.ExportTicket

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>ExportTicket</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ExportDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ExportDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CustomerName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CustomerName)
        </dd>
    </dl>
</div>
<div class="mt-4">
    <h5>Chi tiết phiếu xuất</h5>
    <table class="table">
        <thead>
            <tr>
                <th>Thiết bị</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ExportDetails)
            {
                <tr>
                    <td>@item.Device?.DeviceName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice</td>
                    <td>@item.TotalPrice</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ExportTicketID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
