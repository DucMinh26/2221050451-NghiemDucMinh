@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model BT_NET.Models.Student

@{
    ViewData["Title"] = "Index";
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<h2>Thêm mới sinh viên</h2>
<a href="/Student/Index">Danh sách sinh viên</a>
<form asp-action="Create" asp-controller="Student" method="POST">
    <div>
        <label>Mã sinh viên:</label>
        <input asp-for="StudentCode" class="form-control" />
        <span asp-validation-for="StudentCode" class="text-danger"></span>
    </div>
    <div>
        <label>Họ và tên:</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div>
        <label>Tuổi:</label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>
    <div>
        <label>Email:</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Create</button>
</form>