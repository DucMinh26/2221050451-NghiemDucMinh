@model IEnumerable<BT_NET.Models.Student>
<h2>Danh sách sinh viên</h2>
<a href="/Student/Create">Thêm sinh viên</a>
<table class="table">
    <thead>
        <tr>
            <th>Mã sinh viên</th>
            <th>Họ và tên</th>
            <th>Tuổi</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentCode</td>
                <td>@student.FullName</td>
                <td>@student.Age</td>
                <td>@student.Email</td>
                <td>
                    <a asp-action="Edit" asp-controller="Student" asp-route-id="@student.StudentCode">Edit</a>
                    <a asp-action="Delete" asp-controller="Student" asp-route-id="@student.StudentCode">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>