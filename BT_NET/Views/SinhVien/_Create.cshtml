@model BT_NET.Models.Entities.SinhVien


<form id="createSinhVienForm">
    <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">Thêm Sinh Viên Mới</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div class="mb-3">
            <label asp-for="MaSV" class="form-label fw-bold">Mã sinh viên</label>
            <input asp-for="MaSV" class="form-control" placeholder="Nhập mã SV..." />
            <span asp-validation-for="MaSV" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label fw-bold">Họ và tên</label>
            <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên..." />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Lop" class="form-label fw-bold">Lớp</label>
            <input asp-for="Lop" class="form-control" placeholder="Ví dụ: K17-KTPM" />
            <span asp-validation-for="Lop" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DiemTB" class="form-label fw-bold">Điểm trung bình</label>
            <input asp-for="DiemTB" class="form-control" type="number" step="0.1" placeholder="Nhập điểm..." />
            <span asp-validation-for="DiemTB" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-primary" id="btnSaveCreate">
            <i class="fas fa-save"></i> Lưu lại
        </button>
    </div>
</form>