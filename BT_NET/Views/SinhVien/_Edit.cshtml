@model BT_NET.Models.Entities.SinhVien

<form id="editSinhVienForm">
    <input type="hidden" asp-for="Id" />

    <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title">Chỉnh sửa thông tin Sinh Viên</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div class="mb-3">
            <label asp-for="MaSV" class="form-label fw-bold">Mã sinh viên</label>
            <input asp-for="MaSV" class="form-control bg-light" readonly />
            <span asp-validation-for="MaSV" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label fw-bold">Họ và tên</label>
            <input asp-for="HoTen" class="form-control" />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Lop" class="form-label fw-bold">Lớp</label>
            <input asp-for="Lop" class="form-control" />
            <span asp-validation-for="Lop" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DiemTB" class="form-label fw-bold">Điểm trung bình</label>
            <input asp-for="DiemTB" class="form-control" type="number" step="0.1" />
            <span asp-validation-for="DiemTB" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-warning" id="btnSaveEdit">
            <i class="fas fa-save"></i> Cập nhật
        </button>
    </div>
</form>